rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile documents
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Poker tables
    match /tables/{tableId} {
      allow read, write: if true;
    }

    // Private / Password-protected tables
    match /private_tables/{tableId} {
      allow read, write: if true;
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Verified Receipts collection (Anti-fraud)
    match /verified_receipts/{receiptId} {
      allow read, write: if true;
    }

    // Deposits collection
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Withdrawals collection
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // System Config
    match /system_config/{configId} {
      allow read, write: if true;
    }

    // Fraud Alerts collection
    match /fraud_alerts/{alertId} {
      allow read, write: if true;
    }

    // Live Support Messages collection
    match /support_messages/{messageId} {
      allow read, write: if true;
    }

    // Live Table Chat messages
    match /table_chats/{chatId} {
      allow read, write: if true;
    }

    // Live Table Emojis
    match /table_emojis/{emojiId} {
      allow read, write: if true;
    }

    // 10% Table Rakes collection
    match /table_rakes/{rakeId} {
      allow read, write: if true;
    }
  }
}
